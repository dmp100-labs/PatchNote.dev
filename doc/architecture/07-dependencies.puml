@startuml Module Dependencies

title 모듈 간 의존성 관계 (Google Architecture 기반)

skinparam componentStyle rectangle
skinparam linetype ortho

package "composeApp (UI Layer)" #E3F2FD {
    [Composables\n화면] as UI
    [ViewModels\n상태 관리] as VM
    
    UI --> VM
}

package "shared (Domain + Data)" #FFF3E0 {
    
    package "domain" {
        [Use Cases\n비즈니스 로직] as UC
        [Repository Interfaces] as RepoIf
        [Domain Models] as Models
        
        UC --> RepoIf
        UC --> Models
    }
    
    package "data" {
        [Repository Implementations] as RepoImpl
        [Data Sources\n(Remote + Local)] as DS
        [DTOs & Mappers] as DTO
        
        RepoImpl ..|> RepoIf : implements
        RepoImpl --> DS
        RepoImpl --> DTO
        DTO --> Models : converts to
    }
}

package "server (Backend)" #6DB33F {
    [REST API\nControllers] as API
    [Services\n비즈니스 로직] as Service
    [JPA Repositories] as JPA
    [Database Entities] as DBEntity
    
    API --> Service
    Service --> JPA
    JPA --> DBEntity
}

package "iosApp (iOS UI)" #147EFB {
    [SwiftUI Views] as iOS
    [ViewModels\n(Swift)] as iOSVM
    
    iOS --> iOSVM
}

package "webApp (Web UI)" #61DAFB {
    [React Components] as Web
    [Custom Hooks] as Hooks
    
    Web --> Hooks
}

' UI to Domain dependencies
VM --> UC : invokes
iOSVM --> UC : invokes
Hooks --> UC : invokes

' Data to External
DS --> API : HTTP calls

' Platform-specific shared builds
package "Shared Framework Outputs" {
    [shared.framework\n(iOS)] as SharediOS #7F52FF
    [shared.js\n(Web)] as SharedJS #7F52FF
    [shared.jar\n(JVM)] as SharedJAR #7F52FF
}

shared --> SharediOS : builds
shared --> SharedJS : builds  
shared --> SharedJAR : builds

iOSVM --> SharediOS : imports
Hooks --> SharedJS : imports
VM --> SharedJAR : imports

database "PostgreSQL" as DB
database "Redis Cache" as Redis

Service --> DB : JPA
Service --> Redis : Cache

note right of shared
    **핵심 모듈**
    모든 클라이언트가 의존
    
    - Domain: 순수 비즈니스 로직
    - Data: 데이터 소스 통합
end note

note right of VM
    **단방향 데이터 플로우**
    UI → ViewModel → UseCase
         → Repository → DataSource
    
    StateFlow로 UI 업데이트
end note

note bottom of API
    **서버 역할**
    - REST API 제공
    - 데이터 영속성
    - 비즈니스 규칙 검증
end note

legend right
    |<back:#E3F2FD>   </back>| UI Layer (Clients) |
    |<back:#FFF3E0>   </back>| Domain Layer |
    |<back:#E8F5E9>   </back>| Data Layer |
    |<back:#6DB33F>   </back>| Backend Server |
    |<back:#7F52FF>   </back>| KMP Outputs |
endlegend

@enduml
