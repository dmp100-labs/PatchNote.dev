@startuml ComposeApp Module Structure

title ComposeApp Module - Compose Multiplatform UI

skinparam componentStyle rectangle
skinparam package {
    BackgroundColor #F8F8F8
    BorderColor #999999
}

package "composeApp" {
    
    package "commonMain\n(Compose UI)" #4285F4 {
        [App.kt\n@Composable] as App
        [ui/\nComponents] as UI
        
        note right of App
            **Main Composable**
            - MaterialTheme
            - AnimatedVisibility
            - Image, Button, Text
            
            shared 모듈의
            Greeting 클래스 사용
        end note
        
        App --> UI
    }
    
    package "androidMain" #3DDC84 {
        [MainActivity] as MainActivity
        
        note right of MainActivity
            Android 진입점
            ComponentActivity 상속
            setContent { App() }
        end note
        
        App <.. MainActivity : renders
    }
    
    package "jvmMain\n(Desktop)" #F88909 {
        [Main.kt] as Main
        
        note right of Main
            Desktop 진입점
            Window { App() }
        end note
        
        App <.. Main : renders
    }
}

package "Dependencies" {
    [Compose Runtime] as runtime
    [Compose Foundation] as foundation
    [Material3] as material3
    [ViewModel] as viewmodel
    [shared module] as shared
}

App --> runtime
App --> foundation
App --> material3
App --> viewmodel
App --> shared

note bottom of composeApp
    **빌드 설정**
    - Kotlin Multiplatform Plugin
    - Compose Multiplatform Plugin
    - Compose Compiler Plugin
    - 타겟: Android, JVM(Desktop)
    
    **Desktop 배포**
    - Format: Dmg, Msi, Deb
    - Package: org.patchnote.patchnote
end note

@enduml
